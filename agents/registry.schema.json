{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mofk.local/agents/registry.schema.json",
  "title": "MFK AI workforce agent registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "operational",
    "policyFile",
    "instructionBase",
    "humanOwner",
    "handoffContract",
    "globalForbiddenActions",
    "sensitiveOperations",
    "agents"
  ],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "operational": { "type": "boolean" },
    "policyFile": { "type": "string" },
    "instructionBase": { "type": "string" },
    "humanOwner": { "type": "string", "minLength": 1 },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "handoffContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredInputs",
        "requiredOutputs",
        "cannotSelfApprove",
        "failClosedIfMissingEvidence"
      ],
      "properties": {
        "requiredInputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "requiredOutputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "cannotSelfApprove": { "const": true },
        "failClosedIfMissingEvidence": { "const": true }
      }
    },
    "globalForbiddenActions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "sensitiveOperations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["minLevel", "requiredHumanApprovals", "failClosed"],
        "properties": {
          "minLevel": { "enum": ["L0", "L1", "L2", "L3", "L4"] },
          "requiredHumanApprovals": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "failClosed": { "const": true },
          "default": { "type": "string" },
          "requiresApprovedPr": { "type": "boolean" },
          "separateFromPrApprover": { "type": "boolean" }
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "instructionFile",
          "maxLevel",
          "responsibilities",
          "allowedPaths",
          "forbiddenActions",
          "handoff"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "instructionFile": { "type": "string" },
          "maxLevel": { "enum": ["L0", "L1", "L2", "L3", "L4"] },
          "responsibilities": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "allowedPaths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "forbiddenActions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "handoff": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nextAgentIds", "requiresHumanDecision"],
            "properties": {
              "nextAgentIds": {
                "type": "array",
                "items": { "type": "string" }
              },
              "requiresHumanDecision": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
