EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
EXPO_PUBLIC_AUTH_OTP_MODE=mock
EXPO_PUBLIC_DEV_OTP_CODE=123456

# Leave these empty for the mobile Supabase bridge during development builds.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_DOMAIN=

# Vehicle Health Intelligence (default off). Enable only after QA.
EXPO_PUBLIC_MFK_HEALTH_INTELLIGENCE_ENABLED=false
EXPO_PUBLIC_MFK_APPROVAL_LOGGING_ENABLED=false
EXPO_PUBLIC_MFK_ODOMETER_TRACKING_ENABLED=false
EXPO_PUBLIC_MFK_ANOMALY_DETECTION_ENABLED=false
EXPO_PUBLIC_MFK_OCR_ENABLED=false
