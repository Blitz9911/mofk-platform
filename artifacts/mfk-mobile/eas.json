{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
      ,
      "ios": {
        "simulator": false
      }
    },
    "development-local": {
      "developmentClient": true,
      "distribution": "internal",
      "credentialsSource": "local",
      "ios": {
        "simulator": false
      }
    },
    "uat": {
      "distribution": "internal",
      "credentialsSource": "remote",
      "channel": "uat",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_MFK_ENV": "uat",
        "EXPO_PUBLIC_MFK_UAT_SUPABASE_REF": "nbuqxtasvqdnallukbyx",
        "EXPO_PUBLIC_AUTH_OTP_MODE": "mock",
        "MFK_PUSH_SEND_ENABLED": "false"
      },
      "ios": {
        "simulator": false
      }
    },
    "testflight-uat": {
      "distribution": "store",
      "channel": "uat",
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_MFK_ENV": "uat",
        "EXPO_PUBLIC_MFK_UAT_SUPABASE_REF": "nbuqxtasvqdnallukbyx",
        "EXPO_PUBLIC_AUTH_OTP_MODE": "mock",
        "MFK_PUSH_SEND_ENABLED": "false"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "testflight-uat": {
      "ios": {
        "ascAppId": "6826274563"
      }
    },
    "production": {}
  }
}
