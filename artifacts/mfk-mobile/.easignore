# EAS Build upload rules for this project. By default EAS Build falls back to
# .gitignore, but that file also excludes credentials/ and credentials.json
# (kept out of git deliberately, since they hold private signing material) —
# excluding them from the EAS Build upload too breaks local iOS credentials
# builds silently. This file takes over so credentials still reach the build.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Native (regenerated by prebuild)
ios/
android/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# local env files
.env*.local
.env
